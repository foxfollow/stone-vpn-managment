# Локальний конфіг (скопіюй у config.env — він gitignored).
#   cp config.env.example config.env
#
# Усі значення ОПЦІОНАЛЬНІ й використовуються лише як дефолти.
# Реальний вибір робиться інтерактивно при підключенні і запам'ятовується у state.env.

# Дефолтний шлюз для route-fix маршруту до VPN-сервера (напр. 192.168.0.1).
# Порожньо = при підключенні просто запитає / можна пропустити.
LAN_GATEWAY=

# Дефолтний OpenVPN-логін. Порожньо = береться з auth.txt або питається.
# Багато профілів логін взагалі не потребують — тоді його не питатимуть.
OVPN_USERNAME=

# (опц.) Перевизначити теку OpenVPN-профілів.
# OVPN_PROFILES_DIR="$HOME/Library/Application Support/OpenVPN Connect/profiles"

# DNS, який встановити ПІСЛЯ відключення VPN (напр. "8.8.8.8 8.8.4.4").
# Лікує випадок, коли wg-quick після відключення лишає неробочий DNS від WG.
# Порожньо = НЕ чіпати DNS після відключення.
RESTORE_DNS=

# Мережеві сервіси, до яких застосувати RESTORE_DNS (bash-масив).
# Назви сервісів: networksetup -listallnetworkservices
DNS_SERVICES=("Wi-Fi")
