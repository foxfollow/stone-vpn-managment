    "0/1 + 128.0/1 hijack → %@: a full-tunnel VPN carries all traffic." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перехоплення 0/1 + 128.0/1 → %@: повнотунельний VPN тримає весь трафік."
          }
        }
      }
    },
