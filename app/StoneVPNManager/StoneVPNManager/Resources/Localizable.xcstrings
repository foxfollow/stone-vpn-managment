        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ без інтернету"
          }
        }
      }
    },
    "%@ put its DNS back. Only an up-to-date helper can hold your choice without a password (Settings → Helper)." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ повернув свій DNS. Тримати вибір без пароля може лише актуальний helper (Settings → Helper)."
          }
        }
      }
    },
    "%@ signs in through a browser (SSO) — not possible via the Cisco CLI" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ входить через браузер (SSO) — через Cisco CLI не вийде"
          }
        }
      }
    },
    "%@ stays via %@ on the network “%@”. Reset it in Routes → Decisions." : {
      "localizations" : {
