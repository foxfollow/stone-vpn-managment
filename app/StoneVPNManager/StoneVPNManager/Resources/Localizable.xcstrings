    "A StoneVPN host (not from the Cisco profile)." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Власний хост StoneVPN (не з профілю Cisco)."
          }
        }
      }
    },
    "A VPN Server Goes Through Another Tunnel" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер VPN іде через чужий тунель"
          }
        }
      }
    },
    "A build from source — update it with git pull and make -C app install. Automatic updates come with releases (Homebrew / GitHub Releases)." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збірка з вихідного коду — оновлюється через git pull і make -C app install. Автооновлення є в релізах (Homebrew / GitHub Releases)."
          }
        }
      }
    },
    "A disabled backend is neither shown nor probed. To hide it from the popover without disabling it, use “Edit” in the provider list." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнений бекенд не показується і не опитується. Приховати з поповера, не вимикаючи, — «Змінити» у списку провайдерів."
          }
        }
      }
    },
    "A folder shared with OpenVPN Connect (files are named by ms timestamp — give them aliases in the Profiles window)." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спільна з OpenVPN Connect тека (файли названі ms-timestamp — дай псевдоніми у вікні профілів)."
          }
        }
      }
    },
    "A foreign VPN holds the network" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сторонній VPN тримає мережу"
          }
        }
      }
    },
    "A foreign VPN owns the network" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мережу тримає сторонній VPN"
          }
        }
      }
    },
    "A host route to the VPN server via the LAN gateway, for when macOS sends it out the wrong interface. Servers reachable through another tunnel (VPN-in-VPN) are skipped automatically." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host-маршрут до VPN-сервера через LAN-шлюз, коли macOS веде його не тим інтерфейсом. Сервери, досяжні через інший тунель (VPN-у-VPN), пропускаються автоматично."
          }
        }
      }
    },
    "A port is allowed, e.g. vpn.example.com:8448" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можна з портом, напр. vpn.example.com:8448"
          }
        }
      }
    },
    "A port is allowed: host:8448. A new host is saved to the profile list." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можна з портом: host:8448. Новий хост збережеться у списку профілів."
          }
        }
      }
    },
    "A root daemon for wg-quick / openvpn / DNS / routes without asking for a password every time. It accepts connections only from StoneVPN with the same signature and runs a fixed set of checked actions. Without it, every such action asks for the administrator password." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Root-демон для wg-quick / openvpn / DNS / маршрутів без запиту пароля щоразу. Приймає з'єднання лише від StoneVPN з тим самим підписом і виконує фіксований набір перевірених дій. Без нього кожна дія питає пароль адміністратора."
          }
        }
      }
    },
