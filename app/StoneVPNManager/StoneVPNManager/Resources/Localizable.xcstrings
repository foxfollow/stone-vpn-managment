{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    "%@ (%@) became primary" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) став первинним"
          }
        }
      }
    },
    "%@ (%@) holds the default route and DNS, but passes no traffic. DNS edits won't help." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) тримає default route і DNS, але не пропускає трафік. Правки DNS не допоможуть."
          }
        }
      }
    },
    "%@ (%@) holds the default route and DNS." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) тримає default route і DNS."
          }
        }
      }
    },
    "%@ (%@) — a foreign tunnel, managed by its own app." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) — сторонній тунель, керується своїм застосунком."
          }
        }
      }
    },
    "%@ (%@) — processes that may be holding it:" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) — процеси, що можуть його тримати:"
          }
        }
      }
    },
    "%@ (%@) → %@ direct, around %@. If %@ has a Kill Switch on, it may still pull everything into its tunnel." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) → %3$@ напряму, повз %4$@. Якщо в %5$@ увімкнено Kill Switch, він може й далі тягнути все в тунель."
          }
        }
      }
    },
    "%@ (old version: %@)" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (стара версія: %2$@)"
          }
        }
      }
    },
    "%@ does not resolve (DNS: %@) — the connection will most likely fail. DNS → Fix or a split rule." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не резолвиться (DNS: %2$@) — підключення, найімовірніше, не вдасться. DNS → Fix або split-правило."
          }
        }
      }
    },
    "%@ has no internet — macOS picks by service order, not by reachability." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ без інтернету — macOS обирає за порядком сервісів, не за доступністю."
          }
        }
      }
    },
    "%@ is the address of interface %@, not a DNS server." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — адреса інтерфейсу %2$@, а не DNS-сервер."
          }
        }
      }
    },
    "%@ may hold the network" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ може тримати мережу"
