<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Доповнює згенерований Info.plist (GENERATE_INFOPLIST_FILE). LSUIElement — у build settings.
	     Тексти тут — англійською (мова розробки); переклади — Resources/InfoPlist.xcstrings. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>StoneVPN checks whether the DNS resolver responds and whether each network interface has internet (the resolver is often a server in your LAN). Without this permission the DNS and network indicators may report a false problem.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>StoneVPN closes the Cisco/Defguard GUI before connecting from the CLI and opens Terminal when needed.</string>
	<!-- Репозиторій з config.env/state.env, спільними з main-vpn-manager.sh (build setting STONEVPN_REPO_PATH). -->
	<key>StoneVPNRepoPath</key>
	<string>$(STONEVPN_REPO_PATH)</string>
	<!-- Sparkle. Оновлення вмикає лише CI-реліз (STONEVPN_UPDATES=YES): локальна збірка з
	     Team ID не може оновитися ad-hoc-релізом, тож вона Sparkle не запускає. -->
	<key>StoneVPNUpdates</key>
	<string>$(STONEVPN_UPDATES)</string>
	<key>SUFeedURL</key>
	<string>https://foxfollow.github.io/stone-vpn-managment/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
