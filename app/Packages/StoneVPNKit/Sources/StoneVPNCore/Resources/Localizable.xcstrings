    },
    "Another Cisco client holds the connect capability: the Cisco Secure Client GUI or `vpn` in Terminal. Close it and try again." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Право підключення тримає інший клієнт Cisco: GUI Cisco Secure Client або `vpn` у Terminal. Закрий його і спробуй ще раз."
          }
        }
      }
    },
    "Approve the sign-in in Duo on your phone…" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтверди вхід у Duo на телефоні…"
