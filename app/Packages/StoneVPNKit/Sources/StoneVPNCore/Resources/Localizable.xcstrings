{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ doesn't look like <%@> content" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не схожий на вміст <%2$@>"
          }
        }
      }
    },
    "%@ doesn't look like an OpenVPN profile (no remote / <ca>)" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не схожий на профіль OpenVPN (немає remote / <ca>)"
          }
        }
      }
    },
    "%@ is reachable via %@ — no route-fix needed" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ доступний через %2$@ — route-fix не потрібен"
          }
        }
      }
    },
    "%@ · tunnel" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · тунель"
          }
        }
      }
    },
    "%@d %@" : {
      "comment" : "Elapsed time with days, e.g. 2d 03:04",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
